{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appi",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "be42c270-e604-4623-a5ea-91d2da81858d","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8c5ebabae75c42d9859fefbc17a6af25" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
